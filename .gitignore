# Product repo gitignore - no sessions, no dev tooling, no secrets

# Sessions (should not exist in product repo, prevent accidental inclusion)
_Sessions/
_sessions/

# Temporary files
.tmp_*
*.tmp

# IDE (keep .vscode/ - shared config)
.vs/

# Python
__pycache__/
*.pyc

# API keys and secrets
.api-keys.txt
.env

# Dev tooling (should not exist in product repo)
*.bat
